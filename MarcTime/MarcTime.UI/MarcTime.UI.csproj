<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
	  <!-- AGREGADO 11 -->
	  <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarcTime.Core\MarcTime.Core.csproj" />
    <ProjectReference Include="..\MarcTime.Data\MarcTime.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
  </ItemGroup>


	<!-- Agregado 04 -->
	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="appsettings.Development.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!-- El SDK agrega automaticamente "global using System.Windows.Forms;" al
         activar UseWindowsForms, lo que choca con System.Windows.Application
         (WPF). Como en ServicioNotificaciones.cs ya usamos el alias "WinForms."
         para las clases que si necesitamos (NotifyIcon, ContextMenuStrip), no
         hace falta el using global - lo quitamos para eliminar la ambiguedad. -->
		<Using Remove="System.Windows.Forms" />
	</ItemGroup>

</Project>
