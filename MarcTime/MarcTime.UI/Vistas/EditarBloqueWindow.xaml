<Window x:Class="MarcTime.UI.Vistas.EditarBloqueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo bloque de horario"
        Width="380" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1A1A">
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock x:Name="TextoDia" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

            <TextBlock Text="Curso / actividad existente" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="ComboCursos" DisplayMemberPath="Nombre" Margin="0,0,0,10"/>

            <TextBlock Text="O escribe uno nuevo" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TextoNuevoCurso" Margin="0,0,0,16" Padding="4"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Hora de inicio" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                    <Grid>
                        <TextBox x:Name="TextoHoraInicio" Padding="4" GotFocus="CampoHora_GotFocus" LostFocus="CampoHora_LostFocus"/>
                        <TextBlock x:Name="PlaceholderHoraInicio" Text="7:00" Foreground="#666666" Margin="6,4" IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hora de fin" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                    <Grid>
                        <TextBox x:Name="TextoHoraFin" Padding="4" GotFocus="CampoHora_GotFocus" LostFocus="CampoHora_LostFocus"/>
                        <TextBlock x:Name="PlaceholderHoraFin" Text="21:31" Foreground="#666666" Margin="6,4" IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>
            </Grid>
            <TextBlock Text="Formato 24 horas, ej: 7:00 o 19:30" Foreground="#666666" FontSize="10" Margin="0,-6,0,16"/>

            <TextBlock Text="Ubicación (opcional)" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TextoUbicacion" Margin="0,0,0,16" Padding="4"/>

            <TextBlock Text="Restringir estas apps a este bloque (opcional)" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
            <ItemsControl x:Name="ListaApps" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding NombreVisible}" IsChecked="{Binding Seleccionada}" Foreground="White" Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="TextoError" Foreground="#FF5252" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="BotonCancelar_Click" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Guardar" Click="BotonGuardar_Click" Padding="12,6"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>