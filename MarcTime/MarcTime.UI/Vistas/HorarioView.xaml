<UserControl x:Class="MarcTime.UI.Vistas.HorarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Horario semanal" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>
        
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Dias}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Background="#151515" CornerRadius="6" Margin="0,0,10,0" Padding="10" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{Binding NombreDia}" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                                <ItemsControl ItemsSource="{Binding Bloques}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#252525" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding NombreCurso}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Foreground="#999999" FontSize="11">
                                                        <Run Text="{Binding HoraInicio, StringFormat={}{0:HH\\:mm}}"/>
                                                        <Run Text=" - "/>
                                                        <Run Text="{Binding HoraFin, StringFormat={}{0:HH\\:mm}}"/>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="Editar" FontSize="10" Padding="6,2" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.EditarBloqueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding HorarioClaseId}"/>
                                                        <Button Content="Eliminar" FontSize="10" Padding="6,2"
                                                                Command="{Binding DataContext.EliminarBloqueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding HorarioClaseId}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="+ Agregar bloque" Margin="0,4,0,0" Padding="6,4"
                                        Command="{Binding DataContext.AgregarBloqueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Dia}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>