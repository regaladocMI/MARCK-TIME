<UserControl x:Class="MarcTime.UI.Vistas.HistorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TarjetaApp" TargetType="Button">
            <Setter Property="Background" Value="#1F1F1F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="Historial de uso" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>

            <Border Background="#151515" CornerRadius="6" Padding="16" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TituloGrafica}" Foreground="#CCCCCC" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Ver todo" FontSize="10" Padding="8,4"
                                Command="{Binding VerTodoCommand}" Visibility="{Binding HayAppSeleccionada, Converter={StaticResource BoolAVisibilidad}}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Barras}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="90" Margin="6,0">
                                    <TextBlock Text="{Binding MinutosTotales, StringFormat={}{0} min}" Foreground="#CCCCCC" FontSize="10"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <Border Background="#4A90D9" CornerRadius="3" Height="{Binding AlturaBarra}"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{Binding EtiquetaDia}" Foreground="#999999" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,6,0,4"/>
                                    <Button Content="Borrar" FontSize="9" Padding="4,2" HorizontalAlignment="Center"
                                            Tag="{Binding Fecha}" Click="BotonBorrarDia_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="Aplicaciones (últimos 7 días) — clic para ver su detalle diario" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding UsoPorApp}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TarjetaApp}"
                                Command="{Binding DataContext.SeleccionarAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding AplicacionId}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding NombreVisible}" Foreground="White" FontSize="14"/>
                                    <TextBlock Text="{Binding NombreCategoria, TargetNullValue='Sin categoría'}" Foreground="#888888" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding MinutosTotales, StringFormat={}{0} min}" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>