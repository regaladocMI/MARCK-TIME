<Window x:Class="MarcTime.UI.Vistas.CuentaRegresivaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MARC TIME"
        Width="320" Height="170"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Background="#1F1F1F">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="TextoApp"
                   Foreground="White"
                   FontSize="15"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <TextBlock x:Name="TextoCuenta"
                   Foreground="#FF5252"
                   FontSize="52"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="se cerrará automáticamente"
                   Foreground="#CCCCCC"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>
    </StackPanel>
</Window>