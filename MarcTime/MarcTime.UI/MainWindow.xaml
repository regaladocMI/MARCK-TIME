<Window x:Class="MarcTime.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MarcTime.UI.ViewModels"
        xmlns:vistas="clr-namespace:MarcTime.UI.Vistas"
        Title="MARC TIME"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        Closing="Window_Closing">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:InicioViewModel}"><vistas:InicioView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HorarioViewModel}"><vistas:HorarioView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TareasViewModel}"><vistas:TareasView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistorialViewModel}"><vistas:HistorialView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfiguracionViewModel}"><vistas:ConfiguracionView/></DataTemplate>

        <Style x:Key="BotonMenu" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="4" Margin="8,2" Padding="12,10">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#151515">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="MARC TIME" Foreground="White" FontSize="20" FontWeight="Bold" Margin="20,0,0,24"/>
                <Button Content="Inicio" Style="{StaticResource BotonMenu}" Command="{Binding NavegarInicioCommand}"/>
                <Button Content="Horario" Style="{StaticResource BotonMenu}" Command="{Binding NavegarHorarioCommand}"/>
                <Button Content="Tareas" Style="{StaticResource BotonMenu}" Command="{Binding NavegarTareasCommand}"/>
                <Button Content="Historial" Style="{StaticResource BotonMenu}" Command="{Binding NavegarHistorialCommand}"/>
                <Button Content="Configuración" Style="{StaticResource BotonMenu}" Command="{Binding NavegarConfiguracionCommand}"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="24"/>
    </Grid>
</Window>